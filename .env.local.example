# Copy this file to `.env.local` and fill in real values from
# `supabase start` (local) or your Supabase project dashboard (remote).

# Public — safe to ship to the client.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional: point at a hosted Supabase project. When set, the local stack
# is bypassed for builds / deploys.
NEXT_PUBLIC_SUPABASE_URL_REMOTE=""
NEXT_PUBLIC_SUPABASE_ANON_KEY_REMOTE=""
